{
  "name": "yapdp",
  "version": "0.4.0",
  "private": true,
  "type": "commonjs",
  "description": "yaPDP - Yet Another PDP-11/70 web emulator - development & build scripts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amesk/yaPDP.git"
  },
  "author": {
    "name": "Alexei Eskenazi",
    "email": "alexei.eskenazi@gmail.com"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "wireit",
    "rebuild-boot": "node tools/rebuild-bootcode.js",
    "stage": "node tools/build-desktop.js",
    "desktop": "node tools/build-desktop.js && node tools/tauri-build.js",
    "desktop:minimal": "node tools/build-desktop.js --variant minimal && node tools/tauri-build.js",
    "desktop:full": "node tools/build-desktop.js --variant full && node tools/tauri-build.js",
    "serve": "node tools/serve.js",
    "site:build": "npm run docs && npm --prefix landing run build && node tools/site-preview.js site",
    "site:serve": "node tools/serve.js --port 3000 --dir site --index index.html",
    "site:preview": "npm run site:build && npm run site:serve",
    "screenshots:manual": "node tools/screenshots-manual.js",
    "screenshots:os": "node tools/screenshots-os.js",
    "shots:compare": "node tools/compare-shots.js report",
    "shots:restore": "node tools/compare-shots.js restore",
    "record:video": "node tools/record-video.js",
    "video:intro": "node tools/make-intro.js",
    "video:demo": "node tools/assemble-video.js",
    "clean": "node tools/build-desktop.js --clean",
    "version:sync": "node tools/sync-version.js",
    "state-manifest": "wireit",
    "manifest": "wireit",
    "tape:pack": "node tools/tape-archive.js pack",
    "tape:unpack": "node tools/tape-archive.js unpack",
    "media:compress": "node tools/media-zst.js compress",
    "media:unpack": "node tools/media-zst.js decompress",
    "media:repack": "node tools/media-zst.js repack",
    "media:rt11-util": "node tools/rt11-util.js",
    "e2e:quickboot-manifest": "wireit",
    "e2e:quickboot-deeplink": "wireit",
    "e2e:quickboot-scenario": "wireit",
    "e2e:snapshots": "wireit",
    "e2e:startup-cls": "wireit",
    "e2e:poweron": "wireit",
    "e2e:os": "wireit",
    "e2e:os:legacy": "wireit",
    "e2e:teletype": "wireit",
    "e2e:teletype-tape": "wireit",
    "e2e:bsd": "wireit",
    "e2e:bsd29": "wireit",
    "e2e:xxdp": "wireit",
    "e2e:xxdp:kfp": "wireit",
    "e2e:xxdp:halt": "wireit",
    "e2e:panel": "wireit",
    "e2e:snapshot-image": "wireit",
    "e2e:state": "wireit",
    "e2e:vt100": "wireit",
    "e2e:mobile": "wireit",
    "e2e:share": "wireit",
    "e2e:import-export": "wireit",
    "e2e:state:disk-access": "wireit",
    "e2e:unmount": "wireit",
    "e2e:maintenance": "wireit",
    "e2e:firstrun-deeplink": "wireit",
    "e2e:quickboot-take-control": "wireit",
    "e2e:diskstore": "wireit",
    "validate": "wireit",
    "term": "node tools/headless-term.js",
    "voice": "node tools/voicer.js",
    "manual:build": "wireit",
    "manual:check": "node tools/build-manual.js --check",
    "manual:pdf": "wireit",
    "devlog:build": "wireit",
    "devlog:check": "node tools/build-devlog.js --check",
    "youtube:auth": "node tools/youtube-publish.js --auth",
    "youtube:publish": "node tools/youtube-publish.js",
    "youtube-public": "node tools/youtube-publish.js",
    "docs": "wireit"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.14.0",
    "puppeteer-stream": "^3.0.23",
    "sharp": "^0.35.5",
    "wireit": "^0.14.13"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "puppeteer": "^25.14.0"
  },
  "wireit": {
    "manifest": {
      "command": "node tools/gen-media-manifest.js",
      "files": [
        "media/**",
        "tools/gen-media-manifest.js",
        "media/README.md"
      ],
      "output": [
        "media/manifest.json"
      ]
    },
    "state-manifest": {
      "command": "node tools/gen-state-manifest.js",
      "files": [
        "states/**",
        "tools/gen-state-manifest.js",
        "tools/state-io.js",
        "src/state-format.js",
        "src/state-frame.js"
      ],
      "output": [
        "states/manifest.json"
      ]
    },
    "manual:build": {
      "command": "node tools/build-manual.js --write",
      "files": [
        "docs/manual/**",
        "tools/build-manual.js",
        "tools/manual-template-head.html",
        "tools/manual-template-tail.html"
      ],
      "output": [
        "manual.html",
        "manual_ru.html",
        "landing/src/data/manualData.ts"
      ]
    },
    "devlog:build": {
      "command": "node tools/build-devlog.js --write",
      "files": [
        "docs/devlog/**",
        "tools/build-devlog.js",
        "tools/manual-template-head.html",
        "tools/manual-template-tail.html"
      ],
      "output": [
        "devlog/**",
        "landing/src/data/devlogData.ts"
      ]
    },
    "manual:pdf": {
      "command": "node tools/build-manual-pdf.js",
      "dependencies": [
        "manual:build"
      ],
      "files": [
        "docs/manual/**",
        "tools/build-manual-pdf.js",
        "tools/manual-template-head.html",
        "tools/manual-template-tail.html",
        "manual.html",
        "manual_ru.html",
        "assets/images/**"
      ],
      "output": [
        "manual.pdf",
        "manual_ru.pdf"
      ]
    },
    "docs": {
      "dependencies": [
        "manual:build",
        "devlog:build",
        "manual:pdf"
      ]
    },
    "test": {
      "command": "node tools/run-tests.js",
      "dependencies": [
        "manifest"
      ],
      "files": [
        "src/**",
        "tests/**",
        "assets/**",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "src-tauri/*.json",
        "package.json"
      ]
    },
    "e2e:os": {
