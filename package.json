{
  "name": "yapdp",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "yaPDP - Yet Another PDP-11/70 web emulator - development & build scripts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amesk/yaPDP.git"
  },
  "author": {
    "name": "Alexei Eskenazi",
    "email": "alexei.eskenazi@gmail.com"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "wireit",
    "rebuild-boot": "node tools/rebuild-bootcode.js",
    "stage": "node tools/build-desktop.js",
    "desktop": "node tools/build-desktop.js && node tools/tauri-build.js",
    "desktop:minimal": "node tools/build-desktop.js --variant minimal && node tools/tauri-build.js",
    "desktop:full": "node tools/build-desktop.js --variant full && node tools/tauri-build.js",
    "serve": "node tools/serve.js",
    "screenshots:manual": "node tools/screenshots-manual.js",
    "screenshots:os": "node tools/screenshots-os.js",
    "record:video": "node tools/record-video.js",
    "video:intro": "node tools/make-intro.js",
    "video:demo": "node tools/assemble-video.js",
    "clean": "node tools/build-desktop.js --clean",
    "version:sync": "node tools/sync-version.js",
    "manifest": "wireit",
    "e2e:os": "wireit",
    "e2e:os:legacy": "wireit",
    "validate": "wireit",
    "term": "node tools/headless-term.js"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.8.0",
    "puppeteer-stream": "^3.0.23",
    "wireit": "file:../../../tmp/wireit.tgz"
  },
  "dependencies": {
    "puppeteer": "^25.9.0"
  },
  "wireit": {
    "manifest": {
      "command": "node tools/gen-media-manifest.js",
      "files": [
        "media/**",
        "tools/gen-media-manifest.js",
        "media/README.md"
      ],
      "output": [
        "media/manifest.json"
      ]
    },
    "test": {
      "command": "node tools/run-tests.js",
      "dependencies": [
        "manifest"
      ],
      "files": [
        "src/**",
        "tests/**",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "e2e:os": {
      "command": "node tests/e2e-osboot.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-osboot.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "e2e:os:legacy": {
      "command": "node tests/e2e-osboot.js --legacy",
      "dependencies": [
        "e2e:os"
      ],
      "files": [
        "src/**",
        "tests/e2e-osboot.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "validate": {
      "dependencies": [
        "e2e:os",
        "e2e:os:legacy"
      ]
    }
  }
}
