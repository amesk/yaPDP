{
  "name": "yapdp",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "description": "yaPDP - Yet Another PDP-11/70 web emulator - development & build scripts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amesk/yaPDP.git"
  },
  "author": {
    "name": "Alexei Eskenazi",
    "email": "alexei.eskenazi@gmail.com"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "wireit",
    "rebuild-boot": "node tools/rebuild-bootcode.js",
    "stage": "node tools/build-desktop.js",
    "desktop": "node tools/build-desktop.js && node tools/tauri-build.js",
    "desktop:minimal": "node tools/build-desktop.js --variant minimal && node tools/tauri-build.js",
    "desktop:full": "node tools/build-desktop.js --variant full && node tools/tauri-build.js",
    "serve": "node tools/serve.js",
    "site:build": "npm --prefix landing run build && node tools/site-preview.js site",
    "site:serve": "node tools/serve.js --port 3000 --dir site --index index.html",
    "site:preview": "npm run site:build && npm run site:serve",
    "screenshots:manual": "node tools/screenshots-manual.js",
    "screenshots:os": "node tools/screenshots-os.js",
    "record:video": "node tools/record-video.js",
    "video:intro": "node tools/make-intro.js",
    "video:demo": "node tools/assemble-video.js",
    "clean": "node tools/build-desktop.js --clean",
    "version:sync": "node tools/sync-version.js",
    "manifest": "wireit",
    "tape:pack": "node tools/tape-archive.js pack",
    "tape:unpack": "node tools/tape-archive.js unpack",
    "media:compress": "node tools/media-zst.js compress",
    "media:unpack": "node tools/media-zst.js decompress",
    "e2e:os": "wireit",
    "e2e:bsd": "wireit",
    "e2e:bsd29": "wireit",
    "e2e:os:legacy": "wireit",
    "e2e:xxdp": "wireit",
    "e2e:vt100": "wireit",
    "e2e:mobile": "wireit",
    "validate": "wireit",
    "term": "node tools/headless-term.js",
    "voice": "node tools/voicer.js",
    "manual:build": "node tools/build-manual.js --write",
    "manual:check": "node tools/build-manual.js --check",
    "devlog:build": "node tools/build-devlog.js --write",
    "devlog:check": "node tools/build-devlog.js --check"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.8.0",
    "puppeteer-stream": "^3.0.23",
    "wireit": "^0.14.13"
  },
  "dependencies": {
    "puppeteer": "^25.11.0"
  },
  "wireit": {
    "manifest": {
      "command": "node tools/gen-media-manifest.js",
      "files": [
        "media/**",
        "tools/gen-media-manifest.js",
        "media/README.md"
      ],
      "output": [
        "media/manifest.json"
      ]
    },
    "manual": {
      "command": "node tools/build-manual.js --check",
      "files": [
        "docs/manual/**",
        "tools/build-manual.js",
        "tools/manual-template-head.html",
        "tools/manual-template-tail.html",
        "manual.html",
        "manual_ru.html",
        "landing/src/data/manualData.ts"
      ]
    },
    "test": {
      "command": "node tools/run-tests.js",
      "dependencies": [
        "manifest",
        "manual"
      ],
      "files": [
        "src/**",
        "tests/**",
        "assets/**",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "src-tauri/*.json",
        "package.json"
      ]
    },
    "e2e:os": {
      "command": "node tests/e2e-osboot.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-osboot.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "e2e:os:legacy": {
      "command": "node tests/e2e-osboot.js --legacy",
      "dependencies": [
        "e2e:os"
      ],
      "files": [
        "src/**",
        "tests/e2e-osboot.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "e2e:bsd": {
      "command": "node tests/e2e-bsd-boot.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-bsd-boot.js",
        "tools/**",
        "media/**",
        "package.json"
      ]
    },
    "e2e:bsd29": {
      "command": "node tests/e2e-bsd29-boot.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-bsd29-boot.js",
        "tools/**",
        "media/**",
        "package.json"
      ]
    },
    "e2e:xxdp": {
      "command": "node tests/e2e-xxdp-ekbbf0.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-xxdp-ekbbf0.js",
        "tests/xxdp-lib.js",
        "tests/xxdp-panel.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "validate": {
      "dependencies": [
        "e2e:os",
        "e2e:os:legacy",
        "e2e:bsd",
        "e2e:bsd29",
        "e2e:xxdp",
        "e2e:vt100",
        "e2e:mobile"
      ]
    },
    "e2e:vt100": {
      "command": "node tests/e2e-vt100.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-vt100.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    },
    "e2e:mobile": {
      "command": "node tests/e2e-mobile-input.js",
      "dependencies": [
        "test"
      ],
      "files": [
        "src/**",
        "tests/e2e-mobile-input.js",
        "tools/**",
        "css/**",
        "*.html",
        "media/**",
        "package.json"
      ]
    }
  }
}
