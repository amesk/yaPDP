# ---- Tauri build artifacts ----
src-tauri/target/
src-tauri/gen/schemas/

# ---- Tauri config generated by tools/build-desktop.js (variant copy) ----
# Only tauri.conf.minimal.json and tauri.conf.full.json are tracked.
src-tauri/tauri.conf.json

# ---- Generated staging directory (rebuilt by tools/build-desktop.js) ----
desktop/

# ---- Node tooling (npm) ----
node_modules/

# ---- Generated demo videos (kept out of assets/ so they never reach the site) ----
video/

# ---- Local dev server log ----
serve.log

# ---- Linux build artifacts (deb/rpm/AppImage) ----
dist-linux/

# ---- E2E failure artifacts (screenshots + console tails) ----
tests/artifacts/

# ---- Scratch probe scripts (never commit) ----
*.tmp.js
# ---- Wireit cache ----
.wireit/
# ---- Kokoro-82M model cache (downloaded on first use by kokoro-js) ----
.cache/

# ---- Landing (React SPA) ----
landing/node_modules/
landing/dist/
site/

# Generator dry-run targets (the default mode of both generators)
manual.html.generated
manual_ru.html.generated
landing/src/data/manualData.ts.generated

# ---- Generated documentation — deliberately NOT committed ----
# The sources are docs/manual/*.md (+ ru/), docs/devlog/*.md and the two page
# templates; everything below is built from them. Nothing here is kept in Git
# because every consumer builds it first: the Pages deploy assembles the site in
# CI, landing/ regenerates its data in a `prebuild` hook, and the test suite
# generates in memory. The PDFs additionally carry the day they were produced,
# so re-rendering an unchanged manual is never byte-identical — a committed copy
# could not be drift-checked the way a text output can.
/manual.html
/manual_ru.html
/devlog/
/manual.pdf
/manual_ru.pdf
landing/src/data/manualData.ts
landing/src/data/devlogData.ts
