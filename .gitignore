# ---- Tauri build artifacts ----
src-tauri/target/
src-tauri/gen/schemas/

# ---- Tauri config generated by tools/build-desktop.js (variant copy) ----
# Only tauri.conf.minimal.json and tauri.conf.full.json are tracked.
src-tauri/tauri.conf.json

# ---- Generated staging directory (rebuilt by tools/build-desktop.js) ----
desktop/

# ---- Node tooling (npm) ----
node_modules/

# ---- Generated demo videos (kept out of assets/ so they never reach the site) ----
video/

# ---- Local dev server log ----
serve.log

# ---- Linux build artifacts (deb/rpm/AppImage) ----
dist-linux/

# ---- E2E failure artifacts (screenshots + console tails) ----
tests/artifacts/

# ---- Scratch probe scripts (never commit) ----
*.tmp.js
.wireit/
