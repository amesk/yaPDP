    833						.sbttl	Cassette load & dump routines.
    834
    835					;Process L - load a program from tape
    836
    837					;Input format:
    838
    839					;Frame
    840					;  1	001
    841					;  2	000
    842					;  3	Low order byte count	(Includes all except checksum,
    843					;  4	High order byte count		even the 001 000.)
    844					;  5	Low order load address
    845					;  6	High order load address
    846					;  7..	Data bytes
    847					;  XXX	Checksum	(Includes all the block - even the 001)
    848					;
    849					;The checksum is calculated such that when all the bytes have
    850					;been added up, the low byte of the sum will be zero.
    851					;
    852					;If the byte count is 6, the load address specified will be
    853					;taken to be the start address of the program. If the address
    854					;is even the program will be started, otherwise ODT will be
ODT11S	MACRO V04.00   00:00:06 PAGE 1-15
CASSETTE LOAD & DUMP ROUTINES.

    855					;re-entered.  If (count > 6), the data block will be loaded.
    856					;
    857					;This is the format used by DEC for paper tapes, and can be
    858					;produced using the RT-11 LINK/LDA command.
    859
    860					;Register use:
    861					; R0 - contents of byte		R3 - checksum
    862					; R1 - load address		R4 - Word from L.GWRD; start address
    863					; R2 - byte count		R5 - read subr pointer
    864
