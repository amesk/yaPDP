     83					; Output the top RAD50 char from r4. The RAD50 character set used is:
     84					;	" ABCDEFGHIJKLMNOPQRSTUVWXYZ$./0123456789"
     85					;Note that in this encoding, '$' is 33, the ASCII code for escape.
     86					;There's probably a nice trick in there somewhere, if I could see it :-)
     87
     88	170070	005000 			chr50o:	clr	r0		;Extract a RAD50 char from r4
     89	170072	005200 			1$:	inc	r0		;r0 := r4/1600.   r4 := r4%1600.
     90	170074	162704 	003100 			sub	#1600.,r4	; By repeated subtraction
     91	170100	103374 				bhis	1$
     92	170102	062704 	003100 			add	#1600.,r4	;Correct for the extra subtract
     93	170106	012746 	055440 			mov	#" [,-(sp)	;Convert single RAD50 char to ASCII
     94	170112	005300 				dec	r0		;RAD50 0 is space, is on the stack
     95	170114	001410 				beq	3$
     96	170116	000316 			2$:	swab	(sp)		;Not space, add '@' to convert letters
     97	170120	162700 	000033 			sub	#27.,r0		;Is it really a letter ?
     98	170124	103404 				blo	3$
     99	170126	012716 	044044 			mov	#"$H,(sp)	;No, must be $./ or digit
    100	170132	005700 				tst	r0		;Is it $ ?
    101	170134	001370 				bne	2$		;No, add '-'+27='H' for ./01234567
    102	170136	062600 			3$:	add	(sp)+,r0	;Convert the character
    103	170140	004537 	173014 			jsr	r5,ftyp		;Print it out
    104	170144	005000 				clr	r0		;Multiply r4 by octal 50 to do the next char.
    105
    106					;Routine used by RAD50 conversions, and octal numeric input.
    107					;After calling MUL50:	r4 := r4 * 50 + r0,  r0 := r4 * 8 + r0,  r2 := r2 + 1
    108					;After calling MULIN:	r4 := r4 * 4 + r0,   r2 := r2 + 1
    109
