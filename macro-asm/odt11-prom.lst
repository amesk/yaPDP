      1						.TITLE	ODT11S
      2						.ENABL	LC, AMA
      3						.sbttl	Initialisation & command processors.
      4
      5					;Borrowed from: http://dph.fluff.org/pdp11/odts.mac
      6
      7					;Version of ODT to be blown into a 2716 PROM for use as console ODT on a T-11
      8					;system. This code started life as the DECUS offering ODT11X. It now has many
      9					;more features resembling those of RT-11's ODT.
     10
     11					;Possible additions:
     12					;	XON - XOFF recognition
     13					;	Aborting printout after ;W & ;E
     14					;	<address>;<count>A	Ascii string print/change
     15
     16					;Conditionals are:
     17		000001 			eis=1		;Use the EIS instructions (Only uses SOB)
     18					;lsi=1		;Use MTPS/MFPS, not bus addr 177776 for the status register.
     19
     20					.if ndf,eis
     21						.macro	sob	r,b	;No EIS instructions - macro to allow SOB
     22							dec	r
     23							bne	b
     24						.endm
     25					.endc
     26					.if ndf,lsi
     27		177776 				st=177776		;Not LSI - address of status register
     28						.macro	mtps	status	;Not LSI - macro to allow MTPS
     29							movb	status,@#st
     30						.endm
     31					.endc
     32
     33					.if df,test
     34					o.break	=	3	;BREAK instruction - 3 for normal PDP-11s
     35						.csect	odt11s
     36					.iff
     37		000000 			o.break	=	0	;BREAK instruction - is 0 for T-11
     38	000000					.asect
     39		170000 				.=170000
     40					.endc
     41
     42		000016 			bkp	=	16	;Number of breakpoints-1 mult. by 2
     43		000014 			tvec	=	14	;BREAK vector location
     44		000340 			stm	=	340	;Priority mask - status register
     45		000020 			tbt	=	20	;T-bit mask - status register
     46
     47		177560 			rcsr	=	177560	;r c/sr		Console input port addresses
     48		177562 			rdb	=	177562	;r data buffer
     49		177564 			tcsr	=	177564	;t c/sr		Console output port addresses
     50		177566 			tdb	=	177566	;t data buffer
     51
     52		000015 			cr	=	15	;Carrage return
     53		000012 			lf	=	12	;Line feed
     54
     55					; Initialise ODT
     56
     57	170000				odt::
