{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yaPDP-Minimal",
  "version": "0.1.0",
  "identifier": "org.yapdp.emulator.minimal",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "yaPDP — PDP-11/70 Emulator",
        "url": "pdp11.html",
        "width": 1280,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "yaPDP - Yet Another PDP-11/70 web emulator desktop app (minimal)",
    "longDescription": "yaPDP - Yet Another PDP-11/70 emulator with an authentic front panel and Model 33 ASR teletype, packaged as a native desktop app. Minimal build: ships the core boot images only; other disk/tape images can be dragged & dropped.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "sidebarImage": "installer/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    },
    "resources": {
      "../media/rk0.dsk.zst": "media/rk0.dsk.zst",
      "../media/rk1.dsk.zst": "media/rk1.dsk.zst",
      "../media/DEC-11-AJPB-PB.ptap.zst": "media/DEC-11-AJPB-PB.ptap.zst",
      "../media/DEC-11-O2PA-PB.ptap.zst": "media/DEC-11-O2PA-PB.ptap.zst",
      "../media/ED-11-V004B-8K.ptap.zst": "media/ED-11-V004B-8K.ptap.zst",
      "../media/lander.ptap": "media/lander.ptap"
    },
    "publisher": "Alexei Eskenazi",
    "copyright": "© 2026 Alexei Eskenazi",
    "linux": {
      "deb": {},
      "appimage": {}
    }
  }
}
