{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "PDP-11 Minimal",
    "version": "0.1.0",
    "identifier": "org.pdp11.emulator.minimal",
    "build": {
        "frontendDist": "../desktop"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "PDP-11/70 Emulator",
                "url": "pdp11.html",
                "width": 1280,
                "height": 920,
                "minWidth": 900,
                "minHeight": 640,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Utility",
        "shortDescription": "PDP-11/70 web emulator desktop app (minimal)",
        "longDescription": "A PDP-11/70 (and /45) emulator with an authentic front panel and Model 33 ASR teletype, packaged as a native desktop app. Minimal build: ships the core boot images only; other disk/tape images can be dragged & dropped.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "sidebarImage": "installer/sidebar.bmp"
            },
            "wix": {
                "bannerPath": "installer/banner.bmp",
                "dialogImagePath": "installer/dialog.bmp"
            }
        },
        "resources": {
            "../media/rk0.dsk.zst": "media/rk0.dsk.zst",
            "../media/rk1.dsk.zst": "media/rk1.dsk.zst",
            "../media/bootcode.ptap": "media/bootcode.ptap"
        }
    }
}